BOT_TOKEN=your_telegram_bot_token_here
BOT_MODE=polling
PORT=3000
WEBHOOK_URL=https://hey-sous.com
DB_FILE_NAME=data/heysous.db
LOG_LEVEL=info
NODE_ENV=development

# Claude AI
ANTHROPIC_API_KEY=your-api-key-here
# Model settings (model, max_tokens, effort) live in the AI block of
# src/config.ts -- they move together and are version-controlled, not env vars.
#
# Per-household daily spend ceiling, in USD. Once a household passes this in a
# day (midnight in SESSION_TIMEZONE) Sous stops replying until the next day.
# Accuracy depends on MODEL_PRICING in src/ai/types.ts covering the model in
# use. Default: 5
DAILY_COST_BUDGET_USD=5
# Admin access (comma-separated Telegram numeric user IDs, e.g. "123456789,987654321")
ADMIN_USER_IDS=

# Mini App URL (public HTTPS URL where the Mini App is served)
MINI_APP_URL=https://hey-sous.com/app
