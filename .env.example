BOT_TOKEN=your_telegram_bot_token_here
BOT_MODE=polling
PORT=3000
WEBHOOK_URL=https://hey-sous.com
DB_FILE_NAME=data/heysous.db
LOG_LEVEL=info
NODE_ENV=development

# Claude AI
ANTHROPIC_API_KEY=your-api-key-here
